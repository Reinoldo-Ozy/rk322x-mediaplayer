#!/bin/bash
# Receptor de video na TV (RK3229). Espera stream H.264 por RTP na porta 5004.
# Config validada: zero-copy, 60fps, 0 drops, baixa latencia.
PORT=${TV_PORT:-5004}
JB=${TV_JITTER:-20}
exec gst-launch-1.0 \
  udpsrc port=$PORT buffer-size=16777216 \
    caps="application/x-rtp,media=video,encoding-name=H264,payload=96,clock-rate=90000" \
  ! rtpjitterbuffer latency=$JB \
  ! rtph264depay ! h264parse ! v4l2slh264dec \
  ! kmssink driver-name=rockchip skip-vsync=true qos=false sync=true \
      max-lateness=200000000
# max-lateness de fabrica: 5 ms. Quadro que chegue mais atrasado que isso e
# DESCARTADO, e a TV fica segurando o ultimo — indistinguivel de travamento
# ("A lot of buffers are being dropped" no log). 200 ms de folga mostram o
# quadro atrasado em vez de sumir com ele; nao adiciona latencia, so muda o
# destino de quem ja chegou tarde.
