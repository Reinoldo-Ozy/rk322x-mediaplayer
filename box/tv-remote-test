#!/usr/bin/env python3
"""Pagina de teste do controle infravermelho -- estilo teste de controle.

Serve em :8081 um desenho do controle que acende o botao apertado, conta os
toques e mostra o comando JSON que o tv-remote mandaria para o player. Serve
para responder "o controle esta indo?" sem precisar de video tocando nem de
ler log por SSH.

Le o mesmo /dev/input/eventN que o tv-remote: o evdev entrega uma copia de
cada evento para cada leitor aberto, entao os dois convivem sem roubar tecla
um do outro. Esta pagina nao manda nada para o player -- so observa.

Diagnostico, nao servico de boot: iniciar sob demanda com
  systemctl start tv-remote-test
"""

import json
import os
import queue
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import evdev

NOME_DISPOSITIVO = os.environ.get("TV_REMOTE_INPUT", "gpio_ir_recv")
PORTA = int(os.environ.get("TV_REMOTE_TEST_PORT", "8081"))

# Mesma tabela do tv-remote, so para exibir o que aconteceria.
COMANDOS = {
    "KEY_ENTER": '{"cmd":"toggle"}',
    "KEY_LEFT": '{"cmd":"prev"}',
    "KEY_RIGHT": '{"cmd":"next"}',
    "KEY_UP": '{"cmd":"skip","delta":30}',
    "KEY_DOWN": '{"cmd":"skip","delta":-10}',
    "KEY_BACK": '{"cmd":"stop"}',
    "KEY_HOME": '{"cmd":"status"}',
    "KEY_MENU": '{"cmd":"status"}',
    "KEY_POWER": '{"cmd":"stop"} + CEC standby',
    # Mapeadas como tecla, ainda sem acao no tv-remote. Volume precisaria de um
    # elemento volume no pipeline do player: a placa HDMI desta box nao tem
    # controle de mixer nenhum (so ELD, IEC958 e channel map), entao nao existe
    # volume por hardware para o amixer mexer.
    "KEY_VOLUMEUP": "(sem acao -- HDMI sem mixer)",
    "KEY_VOLUMEDOWN": "(sem acao -- HDMI sem mixer)",
    "KEY_MUTE": "(sem acao -- HDMI sem mixer)",
    "KEY_SETUP": "(mapeada, sem acao)",
    "KEY_BACKSPACE": "(mapeada, sem acao)",
    "KEY_PROG1": "(app -- mapeada, sem acao)",
    "KEY_PROG2": "(mouse -- mapeada, sem acao)",
}
for _n in range(10):
    COMANDOS[f"KEY_{_n}"] = "(digito -- sem acao; ver fila por indice)"

assinantes = set()
trava = threading.Lock()


def publicar(evento):
    dados = json.dumps(evento)
    with trava:
        mortos = []
        for q in assinantes:
            try:
                q.put_nowait(dados)
            except queue.Full:
                mortos.append(q)
        for q in mortos:
            assinantes.discard(q)


def achar_dispositivo():
    for caminho in evdev.list_devices():
        try:
            d = evdev.InputDevice(caminho)
        except OSError:
            continue
        if d.name == NOME_DISPOSITIVO:
            return d
        d.close()
    return None


def leitor():
    """Le o receptor IR e publica cada tecla para os navegadores conectados."""
    while True:
        dev = achar_dispositivo()
        if dev is None:
            publicar({"tipo": "aviso", "texto": f"receptor '{NOME_DISPOSITIVO}' nao encontrado"})
            time.sleep(5)
            continue
        publicar({"tipo": "pronto", "texto": f"{dev.path} ({dev.name})"})
        try:
            for ev in dev.read_loop():
                # MSC_SCAN traz o scancode cru mesmo para botao SEM mapeamento --
                # e o que permite o modo de aprendizado descobrir codigos novos.
                if ev.type == evdev.ecodes.EV_MSC and ev.code == evdev.ecodes.MSC_SCAN:
                    publicar({"tipo": "scan", "codigo": f"0x{ev.value:x}", "t": time.time()})
                    continue
                if ev.type != evdev.ecodes.EV_KEY or ev.value == 0:
                    continue
                tecla = evdev.ecodes.KEY.get(ev.code)
                if isinstance(tecla, list):
                    tecla = tecla[0]
                if tecla is None:
                    tecla = f"COD_{ev.code}"
                publicar({
                    "tipo": "tecla",
                    "tecla": tecla,
                    "repeticao": ev.value == 2,
                    "comando": COMANDOS.get(tecla, "(sem mapeamento)"),
                    "t": time.time(),
                })
        except OSError as e:
            publicar({"tipo": "aviso", "texto": f"leitura interrompida: {e}"})
        finally:
            try:
                dev.close()
            except OSError:
                pass
        time.sleep(2)


# String CRUA de proposito: o JavaScript aqui dentro usa \n em strings dele
# (para montar o TOML). Numa string Python normal o \n vira quebra de linha
# real e parte o literal JS ao meio -- o navegador acusa "Invalid or
# unexpected token" e o script inteiro nao carrega.
PAGINA = r"""<!doctype html>
