      <span style="font-size:22px;font-weight:700" id="alvo"></span>
      <span id="capturado" style="font-family:ui-monospace,monospace"></span>
    </div>
    <textarea id="saida" style="display:none;width:100%;height:260px;margin-top:14px;
      font-family:ui-monospace,monospace;font-size:12px;background:var(--fundo);
      color:var(--tinta);border:1px solid var(--borda);border-radius:8px;padding:10px"></textarea>
  </div>
</div>
</div>
<script>
const LAYOUT=[
 ["KEY_POWER","KEY_MUTE","KEY_SETUP"],
 ["KEY_1","KEY_2","KEY_3"],
 ["KEY_4","KEY_5","KEY_6"],
 ["KEY_7","KEY_8","KEY_9"],
 ["KEY_BACKSPACE","KEY_0","KEY_PROG2"],
 ["KEY_HOME","KEY_UP","KEY_MENU"],
 ["KEY_LEFT","KEY_ENTER","KEY_RIGHT"],
 ["KEY_VOLUMEDOWN","KEY_DOWN","KEY_VOLUMEUP"],
 ["","KEY_BACK","KEY_PROG1"]];
const ROTULO={KEY_POWER:"POWER",KEY_HOME:"HOME",KEY_MENU:"MENU",KEY_UP:"CIMA",
 KEY_LEFT:"ESQ",KEY_ENTER:"OK",KEY_RIGHT:"DIR",KEY_DOWN:"BAIXO",KEY_BACK:"VOLTAR",
 KEY_MUTE:"MUDO",KEY_VOLUMEDOWN:"VOL-",KEY_VOLUMEUP:"VOL+",KEY_SETUP:"SETUP",
 KEY_BACKSPACE:"APAGAR",KEY_PROG2:"MOUSE",KEY_PROG1:"APP",
 KEY_0:"0",KEY_1:"1",KEY_2:"2",KEY_3:"3",KEY_4:"4",KEY_5:"5",KEY_6:"6",
 KEY_7:"7",KEY_8:"8",KEY_9:"9"};
const cont={},elem={};
const grade=document.getElementById("controle");
for(const linha of LAYOUT)for(const k of linha){
  const cel=document.createElement("div");cel.className="cel";
  if(!k){cel.className+=" vazio";grade.appendChild(cel);continue}
  const b=document.createElement("div");
  b.className="b"+(k==="KEY_ENTER"?" ok":"");b.textContent=ROTULO[k];
  const c=document.createElement("span");c.className="cnt";c.textContent="";
  cel.appendChild(b);cel.appendChild(c);grade.appendChild(cel);
  elem[k]={b:b,c:c};cont[k]=0;
}
function acender(k,rep){
  const e=elem[k];if(!e)return;
  e.b.classList.add("on");if(rep)e.b.classList.add("rep");
  clearTimeout(e.t);e.t=setTimeout(()=>{e.b.classList.remove("on","rep")},180);
  cont[k]++;e.c.textContent=cont[k];
}
function registrar(txt,marca){
  const d=document.createElement("div");d.textContent=txt;
  if(marca)d.className="marca";
  const l=document.getElementById("log");l.prepend(d);
  while(l.children.length>60)l.lastChild.remove();
}
const fonte=new EventSource("/eventos");
fonte.onopen=()=>{document.getElementById("ponto").className="ponto ok";
  document.getElementById("conexao").textContent="conectado";};
fonte.onerror=()=>{document.getElementById("ponto").className="ponto";
  document.getElementById("conexao").textContent="desconectado -- tentando de novo";};
// ---- modo aprendizado -------------------------------------------------
// Pergunta um botao por vez e aceita o codigo so depois de ve-lo duas vezes,
// para nao gravar um quadro NEC corrompido (o 0x1ff dos botoes de TV, por
// exemplo) nem o eco de um botao anterior.
const ALVOS=[
 ["KEY_ENTER","OK"],["KEY_UP","seta CIMA"],["KEY_DOWN","seta BAIXO"],
 ["KEY_LEFT","seta ESQUERDA"],["KEY_RIGHT","seta DIREITA"],
 ["KEY_BACK","VOLTAR"],["KEY_HOME","HOME"],["KEY_MENU","MENU"],
 ["KEY_POWER","POWER (da box)"],
 ["KEY_MUTE","MUDO"],["KEY_VOLUMEDOWN","VOL- (da box)"],["KEY_VOLUMEUP","VOL+ (da box)"],
 ["KEY_0","digito 0"],["KEY_1","digito 1"],["KEY_2","digito 2"],["KEY_3","digito 3"],
 ["KEY_4","digito 4"],["KEY_5","digito 5"],["KEY_6","digito 6"],["KEY_7","digito 7"],
 ["KEY_8","digito 8"],["KEY_9","digito 9"],
 ["KEY_BACKSPACE","APAGAR"],["KEY_PROG2","MOUSE"],["KEY_SETUP","SETUP"],["KEY_PROG1","APP"]];
let apr=null;
const $=(id)=>document.getElementById(id);

function mostrarAlvo(){
  $("progresso").textContent=`${apr.i+1} de ${ALVOS.length}`;
  $("alvo").textContent="Aperte: "+ALVOS[apr.i][1];
  $("capturado").textContent="";
  apr.visto=null;apr.n=0;
}
function terminar(){
  $("alvo").textContent="Pronto.";
  $("progresso").textContent=`${Object.keys(apr.mapa).length} teclas capturadas`;
  $("capturado").textContent="";
  let t="# Gerado pelo modo aprendizado do tv-remote-test.\n";
  t+="# NAO mapeie 0x1ff: e o lixo que os botoes da secao de TV produzem.\n\n";
  t+='[[protocols]]\nname = "rk322x_reinoldo"\nprotocol = "nec"\n\n[protocols.scancodes]\n';
  for(const [k,rot] of ALVOS){ if(apr.mapa[k]) t+=`${apr.mapa[k]} = "${k}"\n`; }
  const s=$("saida");s.style.display="block";s.value=t;s.select();
  $("btPular").disabled=true;$("btAbortar").disabled=true;$("btAprender").disabled=false;
  apr.ativo=false;
}
function avancar(){
  apr.i++;
  if(apr.i>=ALVOS.length){terminar();return;}
  mostrarAlvo();
}
$("btAprender").onclick=()=>{
  apr={ativo:true,i:0,mapa:{},visto:null,n:0,usados:new Set()};
  $("painelAprender").style.display="block";$("saida").style.display="none";
  $("btPular").disabled=false;$("btAbortar").disabled=false;$("btAprender").disabled=true;
  mostrarAlvo();
};
$("btPular").onclick=()=>{if(apr&&apr.ativo)avancar();};
$("btAbortar").onclick=()=>{if(apr)terminar();};

function aprenderScan(cod){
  if(cod==="0x1ff"){
    $("capturado").innerHTML='<span class="marca">0x1ff -- botao da secao de TV, ignorado</span>';
    return;
  }
  if(apr.usados.has(cod)){
    $("capturado").innerHTML='<span class="marca">'+cod+' ja usado em outra tecla</span>';
    return;
  }
  if(cod===apr.visto){apr.n++;}else{apr.visto=cod;apr.n=1;}
  $("capturado").textContent=cod+(apr.n<2?"  (aperte de novo para confirmar)":"  confirmado");
  if(apr.n>=2){
    apr.mapa[ALVOS[apr.i][0]]=cod;apr.usados.add(cod);
    registrar("aprendido: "+ALVOS[apr.i][0]+" = "+cod);
    setTimeout(avancar,400);
  }
}

fonte.onmessage=(ev)=>{
  const m=JSON.parse(ev.data);
  if(m.tipo==="scan"){
    if(apr&&apr.ativo)aprenderScan(m.codigo);
    return;
  }
  if(m.tipo==="tecla"){
    acender(m.tecla,m.repeticao);
    document.getElementById("ultima").textContent=m.tecla+(m.repeticao?" (repeticao)":"");
    document.getElementById("comando").textContent=m.comando;
    const h=new Date(m.t*1000).toLocaleTimeString("pt-BR");
    registrar(h+"  "+m.tecla+(m.repeticao?"  [rep]":""),m.repeticao);
  } else {
    registrar("* "+m.texto,true);
  }
};
</script></body></html>
"""


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def do_GET(self):
        if self.path.startswith("/eventos"):
            return self.sse()
        corpo = PAGINA.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(corpo)))
        self.end_headers()
        self.wfile.write(corpo)

    def sse(self):
        q = queue.Queue(maxsize=200)
        with trava:
            assinantes.add(q)
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        try:
            while True:
                try:
                    dados = q.get(timeout=15)
                    self.wfile.write(f"data: {dados}\n\n".encode())
                except queue.Empty:
                    self.wfile.write(b": ping\n\n")  # segura a conexao viva
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass
        finally:
            with trava:
                assinantes.discard(q)


def main():
    threading.Thread(target=leitor, daemon=True).start()
    srv = ThreadingHTTPServer(("0.0.0.0", PORTA), Handler)
    srv.daemon_threads = True
    print(f"teste do controle em http://0.0.0.0:{PORTA}", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
