#!/usr/bin/env python3
"""Página web do box: manda um link do YouTube para a TV pelo celular.

Serve uma página única (sem dependências externas, funciona offline na LAN) e
conversa com o tv-player pelo mesmo protocolo JSON/TCP que o painel do PC usa.
"""
import json
import os
import socket
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORTA = int(os.environ.get("TV_WEB_PORT", "8080"))
PLAYER = ("127.0.0.1", int(os.environ.get("TV_PLAYER_PORT", "5010")))


def player(timeout=8, **kw):
    try:
        s = socket.create_connection(PLAYER, timeout=timeout)
        s.sendall((json.dumps(kw) + "\n").encode())
        r = s.makefile("r").readline()
        s.close()
        return json.loads(r or "{}")
    except Exception as e:
        return {"ok": False, "erro": str(e)}


PAGINA = """<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TV</title>
<style>
  :root{color-scheme:dark light}
  *{box-sizing:border-box}
  body{margin:0;padding:20px;font:16px/1.5 system-ui,sans-serif;
       background:#14161a;color:#e8eaed;display:flex;justify-content:center}
  main{width:100%;max-width:520px}
  h1{font-size:1.25rem;margin:0 0 18px;font-weight:600}
  .cartao{background:#1e2227;border-radius:14px;padding:16px;margin-bottom:14px}
  input{width:100%;padding:14px;font-size:16px;border-radius:10px;
        border:1px solid #3a4048;background:#14161a;color:inherit}
  .linha{display:flex;gap:8px;margin-top:10px}
  button{flex:1;padding:13px;font-size:15px;font-weight:600;border:0;
         border-radius:10px;background:#2b3138;color:#e8eaed;cursor:pointer}
  button.principal{background:#3b82f6;color:#fff}
  button:active{transform:scale(.98)}
  button:disabled{opacity:.45}
  #titulo{font-weight:600;margin-bottom:4px;word-break:break-word}
  #estado{color:#9aa4b2;font-size:.9rem}
  .barra{height:5px;background:#2b3138;border-radius:3px;margin:12px 0 6px;overflow:hidden}
  .barra>i{display:block;height:100%;background:#3b82f6;width:0;transition:width .4s}
  .tempos{display:flex;justify-content:space-between;color:#9aa4b2;
          font-size:.8rem;font-variant-numeric:tabular-nums}
  .ctrl{display:flex;gap:8px;margin-top:12px}
  .ctrl button{font-size:18px;padding:11px}
  .vivo{color:#f87171;font-weight:600}
  .oculto{display:none}
</style>
<main>
  <h1>Mandar para a TV</h1>

  <div class="cartao">
    <input id="link" type="url" inputmode="url" autocomplete="off"
           placeholder="Cole o link do YouTube">
    <div class="linha">
      <button class="principal" onclick="mandar('play')">Tocar agora</button>
      <button onclick="mandar('add')">Na fila</button>
    </div>
  </div>

  <div class="cartao" id="agora">
    <div id="titulo">Nada tocando</div>
    <div id="estado">A TV está livre</div>
    <div id="progresso" class="oculto">
      <div class="barra"><i id="preenche"></i></div>
      <div class="tempos"><span id="pos">0:00</span><span id="dur">0:00</span></div>
    </div>
    <div class="ctrl oculto" id="controles">
      <button onclick="cmd('prev')" id="b-prev">⏮</button>
      <button onclick="cmd('toggle')" id="b-play">⏸</button>
      <button onclick="cmd('next')" id="b-next">⏭</button>
      <button onclick="cmd('stop')">⏹</button>
    </div>
  </div>
</main>
<script>
const $ = i => document.getElementById(i);
const mmss = s => { s=Math.max(0,Math.round(s));
  const h=Math.floor(s/3600), m=Math.floor(s%3600/60), x=s%60;
  return h ? `${h}:${String(m).padStart(2,'0')}:${String(x).padStart(2,'0')}`
           : `${m}:${String(x).padStart(2,'0')}`; };

async function cmd(c, extra={}) {
  const r = await fetch('/api', {method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({cmd:c, ...extra})});
  atualizar(await r.json());
}

async function mandar(c) {
  const url = $('link').value.trim();
  if (!url) return;
  $('titulo').textContent = 'Resolvendo o link...';
  $('estado').textContent = 'A caixinha está buscando, leva alguns segundos';
  $('link').value = '';
  cmd(c, {url});
}

function atualizar(st) {
  if (!st || st.ok === false) return;
  const tocando = st.estado === 'tocando' || st.estado === 'pausado';
  $('progresso').classList.toggle('oculto', !tocando || st.vivo);
  $('controles').classList.toggle('oculto', !tocando);
  if (st.estado === 'resolvendo') { $('titulo').textContent = 'Resolvendo o link...'; return; }
  if (!tocando) {
    $('titulo').textContent = 'Nada tocando';
    $('estado').textContent = 'A TV está livre';
    return;
  }
  $('titulo').textContent = st.titulo || 'Tocando';
  const vivo = !!st.vivo;
  $('b-prev').classList.toggle('oculto', vivo);
  $('b-next').classList.toggle('oculto', vivo);
  $('estado').innerHTML = vivo ? '<span class="vivo">● AO VIVO</span>'
    : (st.estado === 'pausado' ? 'Pausado' : 'Tocando');
  $('b-play').textContent = st.estado === 'pausado' ? '▶' : '⏸';
  if (!vivo && st.dur) {
    $('preenche').style.width = Math.min(100, st.pos / st.dur * 100) + '%';
    $('pos').textContent = mmss(st.pos);
    $('dur').textContent = mmss(st.dur);
  }
}

async function poll() {
  try { atualizar(await (await fetch('/api?cmd=status')).json()); } catch (e) {}
}
setInterval(poll, 1500); poll();
</script>
"""


class Handler(BaseHTTPRequestHandler):
    def _envia(self, corpo, tipo="application/json"):
        b = corpo.encode() if isinstance(corpo, str) else corpo
        self.send_response(200)
        self.send_header("Content-Type", tipo + "; charset=utf-8")
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        p = urllib.parse.urlparse(self.path)
        if p.path == "/api":
            q = urllib.parse.parse_qs(p.query)
            self._envia(json.dumps(player(cmd=q.get("cmd", ["status"])[0])))
        elif p.path in ("/", "/index.html"):
            self._envia(PAGINA, "text/html")
        else:
            self.send_error(404)

    def do_POST(self):
        if urllib.parse.urlparse(self.path).path != "/api":
            return self.send_error(404)
        n = int(self.headers.get("Content-Length") or 0)
        try:
            req = json.loads(self.rfile.read(n) or "{}")
        except Exception:
            return self.send_error(400)
        # resolver um link demora dezenas de segundos no Cortex-A7
        self._envia(json.dumps(player(timeout=180, **req)))

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    print(f"tv-web em http://0.0.0.0:{PORTA}", flush=True)
    ThreadingHTTPServer(("0.0.0.0", PORTA), Handler).serve_forever()
